                <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedHandle"/>
            </owl:Restriction>
        </subClassOf>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A round shaped container used for storing liquid and drinking out of it, typically has  a handle for grasping.</comment>
