<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:swrl="http://www.w3.org/2003/11/swrl#">
    <owl:Ontology rdf:about="http://www.ease-crc.org/ont/SOMA-HOME.owl">
        <owl:imports rdf:resource="http://www.ease-crc.org/ont/SOMA-ALL.owl"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SOMA-HOME defines the concepts that are specific to home, e.g. kitchen environment, household items.</comment>
    </owl:Ontology>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#3DPosition"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#6DPose"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#API_Specification"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#AbductiveReasoning"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Accessor"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Accident"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#ActionExecutionPlan"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Actuating"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#AestheticDesign"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Affordance"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#AffordsBeingSitOn">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Affordance"/>
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes"/>
                <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#CanBeSatOn"/>
            </owl:Restriction>
        </subClassOf>
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#definesBearer"/>
                <owl:allValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#SittingDestination"/>
            </owl:Restriction>
        </subClassOf>
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#definesTrigger"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.ease-crc.org/ont/SOMA.owl#AgentRole"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                                        <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#CanSit"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </subClassOf>
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#definesTask"/>
                <owl:allValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Sitting"/>
            </owl:Restriction>
        </subClassOf>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reified relation between a furniture-like object (the bearer), the sitting task it affords, and an agent that can assume a sitting pose (trigger).</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#AgentRole"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Agonist"/>
