    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#TableFork">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Fork"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A regular size fork used for eating meals, e.g. for Spaghetti.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#TableKnife">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#KitchenKnife"/>
