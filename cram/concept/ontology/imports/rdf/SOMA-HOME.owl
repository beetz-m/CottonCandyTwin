    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#ClausalObject"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Clean"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Cleaning"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Cleanliness"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CleanlinessRegion"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Client-Server_Specification"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#ClientRole"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Closing"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#ClosingDisposition">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Linkage"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The disposition of an object to connect with some other, so that a region of space becomes fully enclosed by the object and separate from the exterior. 

Often this connection is between parts of the same object.

Because of the existence of a separation between some interior and exterior space regions, objects that can close are also objects that can contain.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Clumsiness"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CoffeeCarafe">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Carafe"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A carafe which holds, or at least is intended to usually hold, coffee.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CoffeeTable">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Table"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small and low table which is typically used as a shelf for small items such as cups, and located in front of a sofa.</comment>
    </owl:Class>
