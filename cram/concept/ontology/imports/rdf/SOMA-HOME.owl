        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Dish"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Barrier"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#BedsideTable">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Table"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small table typically located next to a bed.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#BehavioralDiagnosis"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#BeneficiaryRole"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Binding"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Blade">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedComponent"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A flat cutting edge of an object used to cut through other objects, such as the blade of a ventilator cutting through the air.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Blockage"/>
