    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Armchair">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedChair"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A more comfortable chair that includes sides to support arms.</comment>
    </owl:Class>
