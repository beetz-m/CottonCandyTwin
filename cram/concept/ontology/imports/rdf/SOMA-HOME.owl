    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Boiling"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Bottle">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedContainer"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A container with a narrow neck used to store fluids.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Bowl">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Crockery"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A round, deep object used to contain food or liquid.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Box">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedContainer"/>
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasShapeRegion"/>
                <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#BoxShape"/>
            </owl:Restriction>
        </subClassOf>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cuboid-shaped container.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#BoxShape"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Bread">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#BakedGood"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#BreadKnife">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#KitchenKnife"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A knife to cut bread.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#BreakfastPlate">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Plate"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A smaller plate used for serving bread at the dining table with the main meal or to serve breakfast.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Building">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedContainer"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A structure with a roof and walls.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CanBeSatOn">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Deposition"/>
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isDescribedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#AffordsBeingSitOn"/>
            </owl:Restriction>
        </subClassOf>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The disposition to support an agent being in a sitting pose. Typically provided by chairs, stools, etc.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CanCut"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CanSit">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Capability"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The capability of an agent to assume a sitting pose.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Capability"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Capacity"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Carafe">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedContainer"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A container used to hold and pour some beverage.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Catching"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CausalEventRole"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CausativeRole"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CausedMotionTheory"/>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Ceiling">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#RoomSurface"/>
        <owl:disjointWith rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Floor"/>
        <owl:disjointWith rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Wall"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The upper interior surface of a room.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CeramicCooktop">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#ElectricCooktop"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cooktop that uses heated ceramic elements.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CerealBox">
        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Box"/>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A box which holds, or at least is intended to usually hold, cereal flakes.</comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Channel"/>
