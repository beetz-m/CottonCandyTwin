        <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                        <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#CanBeSatOn"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </subClassOf>
        <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The destination of an agent assuming a sitting pose. Typically a chair or stool would fill this role.</comment>
    </owl:Class>
